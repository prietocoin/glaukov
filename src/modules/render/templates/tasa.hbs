<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Noto+Color+Emoji&display=swap');
        
        body {
            font-family: 'Inter', 'Noto Color Emoji', sans-serif;
            /* OPCIÓN DE FONDO ACTUAL: Gradient Deep Tech (Modificable en la sección de fondos) */
            background: radial-gradient(circle at 50% 0%, #064e3b 0%, #022c22 40%, #02120d 100%);
            width: 1080px; 
            height: 1350px; 
            margin: 0;
            padding: 55px;
            color: #ffffff;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .marca-glow { text-shadow: 0 0 25px rgba(59, 130, 246, 0.4); }

        #contenedor-central {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            width: 100%;
            margin: 25px 0;
        }

        .grid-tasas {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-auto-rows: 175px;
            align-content: space-evenly;
            column-gap: 35px;
            width: 100%;
            height: 100%;
        }

        /* CARDS MEJORADAS CON MARCO DESTELLO SUPERIOR */
        .card-tasa {
            background: linear-gradient(160deg, #132235 0%, #0d1724 100%);
            border: 1.5px solid #243852;
            border-top: 3.5px solid #3b82f6; /* Borde de marco llamativo */
            border-radius: 22px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.08);
            padding: 22px 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between; 
            height: 100%;
        }

        /* Títulos de País y Monedas más grandes */
        h2 { 
            font-size: 2.1rem; 
            font-weight: 800; 
            letter-spacing: -0.02em;
        }
        
        .val-num { font-size: 2.65rem; }
        
        .icono-bandera { 
            font-size: 2.6rem; 
            font-family: 'Noto Color Emoji', 'Inter', sans-serif;
        }
        
        .text-label { font-size: 0.95rem; }
    </style>
</head>
<body>

    <!-- CABECERA DE MARCA -->
    <div class="flex justify-between items-center shrink-0">
        <div class="flex items-center gap-4">
            <h1 class="text-5xl font-black tracking-tight marca-glow text-white flex items-center whitespace-nowrap">
                FUNDABLOCK <span class="text-blue-500 mx-4">|</span> 
                <span class="text-4xl font-semibold text-gray-300">{{nombre_socio}}</span>
            </h1>
        </div>
        <div class="flex items-center gap-6 shrink-0">
            <div class="bg-[#1e293b]/90 border border-slate-700 px-6 py-3 rounded-full shadow-lg">
                <span class="text-xl font-semibold text-gray-300">
                    Actualizado: <span class="text-white">{{hora_actualizacion}}</span>
                </span>
            </div>
            
            <!-- CONTENEDOR DE LOGO (Imagen o Insignia) -->
            <div class="w-16 h-16 bg-blue-600/20 rounded-2xl flex items-center justify-center border-2 border-blue-500/50 shadow-xl overflow-hidden p-2">
                <!-- Puedes usar una etiqueta img con el enlace público a tu logo o Base64:
                <img src="https://tu-dominio.com/logo.png" class="w-full h-full object-contain" alt="Logo"> 
                -->
                <span class="text-2xl font-black text-blue-400">FB</span>
            </div>
        </div>
    </div>

    <!-- CUERPO CENTRAL -->
    <div id="contenedor-central">
        <div class="grid-tasas">
            {{#each tarjetas_paises}}
            <div class="card-tasa">
                <div class="flex items-center gap-4 mb-1">
                    <div class="icono-bandera leading-none">{{this.bandera}}</div>
                    <h2 class="text-gray-100 tracking-wide">{{this.nombre_pais}}</h2>
                </div>
                <div class="flex justify-between items-center border-t border-slate-700/80 pt-3">
                    <div class="w-1/2 pr-2">
                        <p class="text-label text-slate-400 font-bold tracking-widest uppercase mb-1">Comprar</p>
                        <p class="font-extrabold text-emerald-400 val-num leading-none">{{this.compra}}</p>
                    </div>
                    <div class="w-[1px] h-12 bg-slate-700/80 mx-2"></div>
                    <div class="w-1/2 pl-2 text-right">
                        <p class="text-label text-slate-400 font-bold tracking-widest uppercase mb-1">Vender</p>
                        <p class="font-extrabold text-rose-400 val-num leading-none">{{this.venta}}</p>
                    </div>
                </div>
            </div>
            {{#each}}
        </div>
    </div>

    <!-- PIE DE IMAGEN -->
    <div class="shrink-0 text-center text-slate-500 text-xl font-medium">
        Tasa base referencial: <span class="text-slate-400">{{tasa_base_ref}}</span> • Generado por Glaukov Engine
    </div>

</body>
</html>
