<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Noto+Color+Emoji&display=swap');
        
        body {
            font-family: 'Inter', 'Noto Color Emoji', sans-serif;
            background: radial-gradient(circle at 50% 0%, #064e3b 0%, #022c22 40%, #02120d 100%);
            width: 1080px; 
            height: 1350px; 
            margin: 0;
            padding: 50px;
            color: #ffffff;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .marca-glow { text-shadow: 0 0 25px rgba(16, 185, 129, 0.4); }

        #contenedor-central {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            width: 100%;
            margin: 20px 0;
        }

        .grid-tasas {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-auto-rows: 180px;
            align-content: space-evenly;
            column-gap: 35px;
            width: 100%;
            height: 100%;
        }

        .card-tasa {
            background: linear-gradient(160deg, #022c22 0%, #02120d 100%);
            border: 1.5px solid #064e3b;
            border-top: 3.5px solid #10b981;
            border-radius: 22px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05);
            padding: 18px 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between; 
            height: 100%;
        }

        .icono-bandera { 
            font-size: 3rem !important; 
            font-family: 'Noto Color Emoji', 'Inter', sans-serif;
        }
    </style>
</head>
<body>

    <!-- CABECERA -->
    <div class="flex justify-between items-center shrink-0">
        <div class="flex items-center gap-4">
            <h1 class="text-5xl font-black tracking-tight marca-glow text-white flex items-center whitespace-nowrap">
                FUNDABLOCK <span class="text-emerald-500 mx-4">|</span> 
                <span class="text-4xl font-semibold text-gray-200">{{nombre_socio}}</span>
            </h1>
        </div>
        
        <!-- LOGO -->
        <div class="w-32 h-32 flex items-center justify-center shrink-0 mr-2">
            {{#if logo_src}}
                <img src="{{logo_src}}" class="w-full h-full object-contain drop-shadow-2xl" alt="FUNDABLOCK">
            {{else}}
                <span class="text-5xl font-black text-emerald-400 drop-shadow-lg">FB</span>
            {{/if}}
        </div>
    </div>

    <!-- CUERPO CENTRAL -->
    <div id="contenedor-central">
        <div class="grid-tasas">
            {{#each tarjetas_paises}}
            <div class="card-tasa">
                <div class="flex items-center gap-3 mb-1">
                    <div class="icono-bandera leading-none shrink-0">{{this.bandera}}</div>
                    <!-- TÍTULO DEL PAÍS CON TAMAÑO FORZADO INLINE (36px) -->
                    <div style="font-size: 36px !important; font-weight: 900 !important; color: #ffffff !important; line-height: 1.1; letter-spacing: -0.02em;" class="truncate">
                        {{this.nombre_pais}}
                    </div>
                </div>
                <div class="flex justify-between items-center border-t border-emerald-900/60 pt-2">
                    <div class="w-1/2 pr-2">
                        <p style="font-size: 18px !important; font-weight: 800 !important; color: #ffffff !important;" class="tracking-widest uppercase mb-1">Comprar</p>
                        <p style="font-size: 42px !important; font-weight: 900 !important;" class="text-emerald-400 leading-none">{{this.compra}}</p>
                    </div>
                    <div class="w-[1px] h-12 bg-emerald-900/50 mx-2"></div>
                    <div class="w-1/2 pl-2 text-right">
                        <p style="font-size: 18px !important; font-weight: 800 !important; color: #ffffff !important;" class="tracking-widest uppercase mb-1">Vender</p>
                        <p style="font-size: 42px !important; font-weight: 900 !important;" class="text-rose-400 leading-none">{{this.venta}}</p>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- PIE DE IMAGEN -->
    <div class="shrink-0 flex justify-between items-center pt-2">
        <div style="font-size: 22px !important; color: #ffffff !important; font-weight: 700 !important;">
            Tasa base referencial: <span class="text-emerald-300 font-bold">{{tasa_base_ref}}</span> • Glaukov Engine
        </div>

        <div class="bg-emerald-950/90 border border-emerald-700 px-6 py-2.5 rounded-full shadow-lg">
            <span style="font-size: 20px !important; color: #ffffff !important; font-weight: 700 !important;">
                Actualizado: <span class="text-emerald-400 font-bold">{{hora_actualizacion}}</span>
            </span>
        </div>
    </div>

</body>
</html>
