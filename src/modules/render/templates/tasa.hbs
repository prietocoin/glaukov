<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Noto+Color+Emoji&display=swap');
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', 'Noto Color Emoji', sans-serif;
            background-color: #040a17;
            margin: 0;
            padding: 0;
            width: 1080px;
        }

        /* CONTENEDOR PRINCIPAL CON FONDO AZUL COBALTO RADIAL */
        #app-container {
            width: 1080px;
            background: radial-gradient(circle at 50% 0%, #1e3a8a 0%, #0f172a 45%, #040a17 100%);
            padding: 50px;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }

        /* CABECERA */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .brand-title {
            font-size: 48px;
            font-weight: 900;
            color: #ffffff;
            text-shadow: 0 0 25px rgba(59, 130, 246, 0.4);
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        .brand-divider {
            color: #3b82f6;
            margin: 0 15px;
        }

        .socio-name {
            font-size: 38px;
            font-weight: 600;
            color: #e2e8f0;
        }

        .logo-container {
            width: 130px;
            height: 110px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .logo-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5));
        }

        /* GRID DE TARJETAS */
        .grid-tasas {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-gap: 25px 35px;
            margin-bottom: 40px;
        }

        /* TARJETAS CON MARCO AZUL Y LUZ SUPERIOR */
        .card-tasa {
            background: linear-gradient(160deg, #0f172a 0%, #070d19 100%);
            border: 1.5px solid #1e3a8a;
            border-top: 4px solid #3b82f6;
            border-radius: 20px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.6);
            padding: 20px 26px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 180px;
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .bandera {
            font-size: 40px;
            line-height: 1;
            font-family: 'Noto Color Emoji', 'Inter', sans-serif;
            flex-shrink: 0;
        }

        .nombre-pais {
            font-size: 34px !important;
            font-weight: 900 !important;
            color: #ffffff !important;
            letter-spacing: -0.5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-body {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(30, 58, 138, 0.8);
            padding-top: 12px;
        }

        .col-precio { width: 48%; }

        /* ETIQUETAS Y VALORES */
        .label-operacion {
            font-size: 18px !important;
            font-weight: 800 !important;
            color: #ffffff !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .val-compra {
            font-size: 42px !important;
            font-weight: 900 !important;
            color: #38bdf8 !important; /* Cyan / Azul brillante */
            line-height: 1;
        }

        .val-venta {
            font-size: 42px !important;
            font-weight: 900 !important;
            color: #fb7185 !important; /* Rosa / Rojo neón */
            line-height: 1;
            text-align: right;
        }

        .divider-vertical {
            width: 1px;
            height: 48px;
            background-color: rgba(30, 58, 138, 0.8);
        }

        /* INDICADORES DE TENDENCIA (VERDE / ROJO / AMARILLO) */
        .trend-up::after {
            content: '▲';
            font-size: 15px;
            color: #10b981;
            margin-left: 5px;
            vertical-align: baseline;
            text-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
        }

        .trend-down::after {
            content: '▼';
            font-size: 15px;
            color: #f43f5e;
            margin-left: 5px;
            vertical-align: baseline;
            text-shadow: 0 0 8px rgba(244, 63, 94, 0.6);
        }

        .trend-stable::after {
            content: '=';
            font-size: 17px;
            font-weight: 900;
            color: #facc15;
            margin-left: 5px;
            vertical-align: middle;
            text-shadow: 0 0 8px rgba(250, 204, 21, 0.5);
        }

        /* PIE DE PÁGINA */
        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 10px;
        }

        .footer-texto {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
        }

        .tasa-ref { color: #93c5fd; }

        .badge-actualizado {
            background-color: rgba(15, 23, 42, 0.9);
            border: 1px solid #1d4ed8;
            padding: 8px 24px;
            border-radius: 50px;
            font-size: 20px;
            font-weight: 700;
            color: #ffffff;
        }

        .time-val { color: #60a5fa; }
    </style>
</head>
<body>

    <div id="app-container">
        <!-- CABECERA -->
        <div class="header">
            <div class="brand-title">
                FUNDABLOCK <span class="brand-divider">|</span> 
                <span class="socio-name">{{nombre_socio}}</span>
            </div>
            
            <div class="logo-container">
                {{#if logo_src}}
                    <img src="{{logo_src}}" class="logo-img" alt="FUNDABLOCK">
                {{else}}
                    <span style="font-size: 48px; font-weight: 900; color: #60a5fa;">FB</span>
                {{/if}}
            </div>
        </div>

        <!-- CUERPO CENTRAL DE TARJETAS -->
        <div class="grid-tasas">
            {{#each tarjetas_paises}}
            <div class="card-tasa">
                <div class="card-header">
                    <div class="bandera">{{this.bandera}}</div>
                    <div class="nombre-pais">{{this.nombre_pais}}</div>
                </div>
                <div class="card-body">
                    <div class="col-precio">
                        <p class="label-operacion trend-{{this.trend_compra}}">Comprar</p>
                        <p class="val-compra">{{this.compra}}</p>
                    </div>
                    <div class="divider-vertical"></div>
                    <div class="col-precio" style="text-align: right;">
                        <p class="label-operacion trend-{{this.trend_venta}}">Vender</p>
                        <p class="val-venta">{{this.venta}}</p>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>

        <!-- PIE DE IMAGEN -->
        <div class="footer">
            <div class="footer-texto">
                Tasa base referencial: <span class="tasa-ref">{{tasa_base_ref}}</span> • Glaukov Engine
            </div>

            <div class="badge-actualizado">
                Actualizado: <span class="time-val">{{hora_actualizacion}}</span>
            </div>
        </div>
    </div>

</body>
</html>
