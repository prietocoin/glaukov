<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Fundablock - Glaukov Engine Atenea V2.0</title>

  <!-- PWA Y CONFIGURACIÓN TEMÁTICA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#030611">

  <!-- SCRIPTS PRINCIPALES Y ALPINE.JS -->
  <script src="/js/api.js?v=2.0"></script>
<script type="module" src="/js/views/comprobantes.js"></script>
  <script type="module" src="/js/views/directorio.js?v=2.0"></script>
  <script src="/js/app.js?v=2.0"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <link rel="icon" type="image/png" href="/logo-fundablock.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: { 
            glaukov: { 
              bg: '#030611', card: '#060c24', border: '#16224f', 
              blue: '#2563eb', neon: '#06b6d4', pink: '#ec4899', green: '#10b981'
            } 
          }
        }
      }
    }
  </script>
  
  <style>
    [x-cloak] { display: none !important; }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: #030611; }
    ::-webkit-scrollbar-thumb { background: #16224f; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #2563eb; }
    input, select, textarea { font-size: 14px !important; }

    @media print {
      body * { visibility: hidden; }
      #reporte-html-documento, #reporte-html-documento * { visibility: visible; }
      #reporte-html-documento { position: absolute; left: 0; top: 0; width: 100%; background: #ffffff !important; color: #000000 !important; }
      .no-imprimir { display: none !important; }
    }
  </style>
</head>

<!-- x-init FORZA A QUE LA VISTA INICIAL SEA SIEMPRE 'comprobantes' AL RECARGAR -->
<body class="bg-[#030611] text-slate-100 font-sans antialiased min-h-screen selection:bg-cyan-500 selection:text-black" 
      x-data="app" 
      x-init="vistaActiva = 'comprobantes'" 
      x-cloak>

  <div class="flex flex-col md:flex-row min-h-screen">
    
    <!-- NAVEGACIÓN LATERAL PRINCIPAL -->
    <%- include('./components/layout/Sidebar.html') %>

    <!-- ÁREA DE CONTENIDO DINÁMICO -->
    <main class="flex-1 p-3 md:p-6 overflow-x-hidden space-y-4 md:space-y-5">
      
   <!-- VISTA 1: AUDITORÍA DE COMPROBANTES -->
<div x-show="vistaActiva === 'comprobantes'" x-data="comprobantesView()" class="space-y-3 md:space-y-4">
  <%- include('./components/comprobantes/HeaderKPIs.html') %>
  <%- include('./components/comprobantes/BarraFiltrosAuditoria.html') %>
  <%- include('./components/comprobantes/ListaComprobantesCards.html') %>
</div>

      <!-- VISTA 2: CARTELERA DE TASAS -->
      <div x-show="vistaActiva === 'cartelera'" class="space-y-4">
        <%- include('./components/tasas/VistaTasas.html') %>
      </div>

      <!-- VISTA 3: DIRECTORIO DE SOCIOS -->
      <div x-show="vistaActiva === 'directorio'" class="space-y-4">
        <%- include('./components/directorio/VistaDirectorio.html') %>
      </div>

      <!-- VISTA 4: DASHBOARD (MOVIDO AL FINAL) -->
      <div x-show="vistaActiva === 'dashboard'" x-data="dashboardView()" class="space-y-4">
  <%- include('./components/dashboard/BalancePendientes.html') %>
  <%- include('./components/dashboard/InspeccionLotes.html') %>
</div>

    </main>
  </div>

  <!-- COMPONENTES MODALES FLOTANTES -->
  <%- include('./components/directorio/ModalConfigSocio.html') %>
  <%- include('./components/comprobantes/ModalEditarComprobante.html') %>
  <%- include('./components/comprobantes/ModalVisorImagen.html') %>
  <%- include('./components/reportes/ModalReporteEvolution.html') %>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((err) => {
        console.warn('Error al registrar Service Worker PWA:', err);
      });
    });
  }
</script>
</body>
</html>
